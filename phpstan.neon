includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
    level: 6
    paths:
        - kloudstack-azure-observability.php
        - src
        - loader
    excludePaths:
        - legacy/*
        - src/Client/assets/*
    bootstrapFiles:
        - tests/phpstan-bootstrap.php
    scanFiles:
        - tests/phpstan-stubs.php
    treatPhpDocTypesAsCertain: false

    # Cap parallelism. PHPStan's memory limit applies PER WORKER, and phpstan-wordpress loads a
    # ~6 MB stub file into each one, so the ceiling is reached by running more workers rather than
    # by analysing more code. On a 2-core GitHub runner the wall-clock cost of capping this is
    # negligible; the alternative is an out-of-memory crash that reports no findings at all and
    # looks exactly like a code failure.
    parallel:
        maximumNumberOfProcesses: 2